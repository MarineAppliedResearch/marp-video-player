# marp-video-player — example environment file
#
# Copy to .env and fill in. `.env` is git-ignored.
#
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# Only the browser test suite needs any of this. The unit tests
# (`npm test`) need nothing, and `npm run serve` needs nothing.


# ---------------------------------------------------------------------------
# Test media source — the LIVE Jellyfin server
# ---------------------------------------------------------------------------
# Used once, read-only, to download fixtures into .test-media/ before the
# browser suite runs. Nothing else in the suite touches this server.
#
# .test-media/ is git-ignored: it holds real survey footage and this
# repository is public.

MARP_MEDIA_JELLYFIN_URL=http://your-live-jellyfin:8096
MARP_MEDIA_JELLYFIN_USERNAME=replace-with-username
MARP_MEDIA_JELLYFIN_PASSWORD=replace-with-password

# Library item downloaded as the primary fixture: 24s of 1080p h264 at 25fps,
# about 2.7 MB. Override to use different footage.
# MARP_FIXTURE_ITEM_SHORT=b24751c817e84b7fc2c090b70163d007


# ---------------------------------------------------------------------------
# Jellyfin API under test — the DEVELOPMENT server
# ---------------------------------------------------------------------------
# Every test that calls a Jellyfin API uses this one. Keep it pointed at the
# development server: the playback-reporting tests write resume positions, and
# the behind-session tests open transcode sessions. Neither belongs on live.

MARP_API_JELLYFIN_URL=http://your-dev-jellyfin:8097
MARP_API_JELLYFIN_USERNAME=replace-with-username
MARP_API_JELLYFIN_PASSWORD=replace-with-password

# Item on the development server used by the Jellyfin playback tests.
# MARP_API_JELLYFIN_ITEM=


# ---------------------------------------------------------------------------
# Server under test
# ---------------------------------------------------------------------------
# Playwright starts tools/serve.mjs itself and reuses an already-running one.
# Override only to test against a player served elsewhere.

# MARP_PLAYER_TEST_PORT=8099
# MARP_PLAYER_TEST_URL=http://localhost:8099/
