# --- Dependencies and build output ---
node_modules/
dist/
app/dist/
docs/generated/

# --- Test artifacts ---
test-results/
playwright-report/

# Test media downloaded from Jellyfin by the E2E global setup. Real survey
# footage, and this repository is public, so it must never be committed.
.test-media/

# --- Local configuration ---
# .env.example is committed and must stay committed: it is how a developer
# configures the test suite. The negation has to come after the .env.* rule,
# because git applies the last matching pattern.
.env
.env.*
!.env.example
app/dev-config.js

# --- Noise ---
*.log
Thumbs.db
.DS_Store
release/

# --- Harness: machine-specific operational notes ---
# Hosts, accounts and key paths for one developer. Repository files may say that a
# credential exists and where it lives, never its value.
.marp/local/
