{
  // Five actions, matching the five things anyone actually does here. All of
  // them run under the debugger, so breakpoints work without a separate
  // "debug" variant of each entry.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open player in browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8099/app/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Build library and serve",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./*": "${workspaceFolder}/*",
        "/./*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Run unit tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "--forceExit"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Run browser tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Build library",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/build.js",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Publish a new version",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/publish.mjs",
      "args": ["${input:releaseKind}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Build docs",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jsdoc/jsdoc.js",
      "args": ["-c", "jsdoc.config.json", "--lenient"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
    ],

  // Asked when "Publish a new version" starts. A version number can never be
  // reused once published, so the choice is made deliberately rather than
  // defaulted.
  "inputs": [
    {
      "id": "releaseKind",
      "type": "pickString",
      "description": "What kind of change is this?",
      "options": [
        { "label": "patch - a fix, no API change", "value": "patch" },
        { "label": "minor - new features, still backwards compatible", "value": "minor" },
        { "label": "major - the host contract changed", "value": "major" }
      ]
    }
  ]
}
