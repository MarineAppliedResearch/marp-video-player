{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open player in browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8099/app/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Build library and serve",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./*": "${workspaceFolder}/*",
        "/./*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Debug unit tests (all)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "--forceExit"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug unit tests (current file)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "--forceExit", "--runTestsByPath", "${relativeFile}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug the build",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/build.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug a probe (current file)",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
