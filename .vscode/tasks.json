{
  "version": "2.0.0",

  // Deliberately small. Building, testing, and serving are in the Run and
  // Debug launcher; these are only the pieces the launcher depends on, plus
  // one-time setup. Duplicating everything here made two menus to choose
  // between for the same actions.
  //
  // Tasks invoke npm.cmd on Windows rather than the "npm" task type. VS Code
  // runs tasks through PowerShell, which resolves bare `npm` to npm.ps1 and
  // then refuses to load it when the execution policy is Restricted. A .cmd
  // shim is not affected by execution policy.
  "tasks": [
    {
      "label": "Build library",
      "detail": "esbuild: ESM, IIFE, and minified standalone bundles into dist/.",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "windows": {
        "command": "npm.cmd"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Serve player",
      "detail": "Static server on port 8099, serving the player at /app/index.html.",
      "type": "shell",
      "command": "npm",
      "args": ["run", "serve"],
      "windows": {
        "command": "npm.cmd"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "marp-serve",
        "pattern": [
          {
            "regexp": "^(.*)$",
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "player at http://localhost"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build library and serve",
      "detail": "Used by the 'Open player in browser' launcher entry.",
      "dependsOrder": "sequence",
      "dependsOn": ["Build library", "Serve player"],
      "problemMatcher": []
    },
    {
      "label": "Install Playwright browsers",
      "detail": "One-time setup on a new machine, before the browser tests can run.",
      "type": "shell",
      "command": "npx",
      "args": ["playwright", "install", "chromium"],
      "windows": {
        "command": "npx.cmd"
      },
      "problemMatcher": []
    }
  ]
}
